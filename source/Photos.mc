import Toybox.Lang;

// Generated by data/photos.py; edit TITLES there and re-run instead of editing this.
// Built once and kept: rebuilding 96 entries per call trips the watchdog on the Descent Mk1.
var gPhotos as Dictionary<String, Array>?;

//! Species name -> [bitmap, credit], or null when the entry has no photo.
function photo(name as String) as Array? {
    var p = gPhotos;
    if (p == null) {
        p = {
            "Kelp bass (calico)" => [Rez.Drawables.p_kelp_bass_calico, "Pictured: Paralabrax clathratus. Photo: Steve Lonhart/MBNMS, Public domain, via Wikimedia Commons (File:Paralabrax_clathratus.jpg)"],
            "Barred sand bass" => [Rez.Drawables.p_barred_sand_bass, "Pictured: Barred sand bass. Photo: NickW557, CC BY-SA 4.0, via Wikimedia Commons (File:P_nebulifer.jpg)"],
            "Spotted sand bass" => [Rez.Drawables.p_spotted_sand_bass, "Pictured: Spotted sand bass. Photo: Marcus Bullock, CC BY 3.0, via Wikimedia Commons (File:Paralabrax_maculatofasciatus.jpg)"],
            "White seabass" => [Rez.Drawables.p_white_seabass, "Pictured: White seabass. Photo: Unknown, Public domain, via Wikimedia Commons (File:Atractoscion_nobilis_mspc096.jpg)"],
            "Giant (black) sea bass" => [Rez.Drawables.p_giant_black_sea_bass, "Pictured: Giant sea bass. Photo: Caitlin Childs, CC BY-SA 2.0, via Wikimedia Commons (File:Giant_Sea_Bass,_CAS.jpg)"],
            "California sheephead" => [Rez.Drawables.p_california_sheephead, "Pictured: California sheephead. Photo: Unknown, CC BY-SA 2.5, via Wikimedia Commons (File:Sheephead.JPG)"],
            "Ocean whitefish" => [Rez.Drawables.p_ocean_whitefish, "Pictured: Ocean whitefish. Photo: Smith, Elder &amp; Co, Public domain, via Wikimedia Commons (File:Caulolatilus_princeps.jpg)"],
            "CA scorpionfish (sculpin)" => [Rez.Drawables.p_ca_scorpionfish_sculpin, "Pictured: Scorpaena guttata. Photo: Linda Santschi, Copyrighted free use, via Wikimedia Commons (File:Scorpaena_guttata.jpg)"],
            "Garibaldi" => [Rez.Drawables.p_garibaldi, "Pictured: Garibaldi. Photo: Stan Shebs, CC BY-SA 3.0, via Wikimedia Commons (File:Hypsypops_rubicundus_adult.jpg)"],
            "Gulf & broomtail grouper" => [Rez.Drawables.p_gulf_broomtail_grouper, "Pictured: Gulf grouper. Photo: Chris Wheaton, CC BY 3.0, via Wikimedia Commons (File:Gulf_grouper.png)"],
            "Opaleye" => [Rez.Drawables.p_opaleye, "Pictured: Girella nigricans. Photo: Stickpen, Public domain, via Wikimedia Commons (File:Girellanigricans.jpg)"],
            "Halfmoon" => [Rez.Drawables.p_halfmoon, "Pictured: Halfmoon. Photo: lwolfartist, CC BY 2.0, via Wikimedia Commons (File:Fish_Georgia_aquarium_-_37513136486_(cropped).jpg)"],
            "Sargo" => [Rez.Drawables.p_sargo, "Pictured: Anisotremus davidsonii. Photo: Donald Davesne, CC BY 4.0, via Wikimedia Commons (File:Anisotremus_davidsonii_231885543.jpg)"],
            "Black croaker" => [Rez.Drawables.p_black_croaker, "Pictured: Cheilotrema saturnum. Photo: Theo Modder, CC BY 3.0, via Wikimedia Commons (File:Cheilotrema_saturnum.jpg)"],
            "Vermilion/sunset rockfish" => [Rez.Drawables.p_vermilion_sunset_rockfish, "Pictured: Sebastes miniatus. Photo: Steve Lonhart / NOAA MBNMS, Public domain, via Wikimedia Commons (File:Sebastes_miniatus_8.jpg)"],
            "Copper rockfish" => [Rez.Drawables.p_copper_rockfish, "Pictured: Copper rockfish. Photo: Chad King (SIMoN / MBNMS), Public domain, via Wikimedia Commons (File:Sebastes_caurinus_1.jpg)"],
