            "Bocaccio" => [Rez.Drawables.p_bocaccio, "Pictured: Bocaccio rockfish. Photo: Chad King (SIMoN / MBNMS), Public domain, via Wikimedia Commons (File:Sebastes_paucispinis.jpg)"],
            "Treefish" => [Rez.Drawables.p_treefish, "Pictured: Treefish. Photo: Unknown, CC BY-SA 2.5, via Wikimedia Commons (File:Treefish.JPG)"],
            "Gopher rockfish" => [Rez.Drawables.p_gopher_rockfish, "Pictured: Gopher rockfish. Photo: No machine-readable author provided. Brighterorange assumed (based on copyright , CC BY-SA 3.0, via Wikimedia Commons (File:Gopher_rockfish.jpg)"],
            "Black-and-yellow rockfish" => [Rez.Drawables.p_black_and_yellow_rockfish, "Pictured: Sebastes chrysomelas. Photo: Claire Fackler, NOAA National Marine Sanctuaries, Public domain, via Wikimedia Commons (File:Black_yellow_rockfish.jpg)"],
